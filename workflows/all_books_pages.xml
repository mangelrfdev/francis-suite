<?xml version="1.0" encoding="UTF-8"?>
<francis-workflow>

    <!--
        All pages — books.toscrape.com catalogue (every listing page).
        Audit layout: each run writes under output/{SOURCE}_{UTC}_{SHORT_ID}/ (no runs/ segment).
        Segment order: source (what), UTC time (when), short id (unique batch).
        Defaults render in CAPS via toUpperCase; pass params from shell for production.
        ingestion_run_id: full UUID for DB lineaje (optional param; defaults local-dev).
        RUN_MANIFEST.JSON: small index for ingest jobs (paths and ids). LISTINGS NDJSON is full rows, not URLs only.
        Twin: workflows/all_books_pages.xml — keep in sync.
    -->

    <shared-box-def name="ingestion_run_id" replace="false">local-dev</shared-box-def>
    <shared-box-def name="run_utc" replace="false">nodate</shared-box-def>
    <shared-box-def name="run_short_id" replace="false">local</shared-box-def>
    <shared-box-def name="source" replace="false">books_toscrape</shared-box-def>

    <box-def name="workflow_key">books_toscrape_all_pages</box-def>
    <box-def name="scraper_name">books_toscrape_all_pages</box-def>
    <box-def name="case_key">demo-books-catalogue</box-def>

    <box-def name="run_dir">
        <compose>${source.toUpperCase()}_${run_utc.toUpperCase()}_${run_short_id.toUpperCase()}</compose>
    </box-def>

    <box-def name="base_url">http://books.toscrape.com/catalogue/</box-def>
    <box-def name="url_actual">http://books.toscrape.com/catalogue/page-1.html</box-def>
    <box-def name="hay_siguiente">true</box-def>
    <box-def name="pagina">0</box-def>
    <box-def name="contador">0</box-def>

    <record-create name="booksRecords">
        <record-metadata>
            <metadata-add-field name="scraper_name">${scraper_name}</metadata-add-field>
            <metadata-add-field name="case_key">${case_key}</metadata-add-field>
            <metadata-add-field name="ingestion_run_id">${ingestion_run_id}</metadata-add-field>
            <metadata-add-field name="run_utc">${run_utc}</metadata-add-field>
            <metadata-add-field name="run_short_id">${run_short_id}</metadata-add-field>
            <metadata-add-field name="run_dir">${run_dir}</metadata-add-field>
            <metadata-add-field name="source">${source}</metadata-add-field>
        </record-metadata>
        <record-export-attr name="example">all_books_pages</record-export-attr>
        <record-export-attr name="case_key">${case_key}</record-export-attr>
        <record-export-attr name="source">books.toscrape.com</record-export-attr>
        <record-export-system name="session_id"/>
        <record-export-system name="exported_at"/>
        <record-export-system name="francis_suite_version"/>
        <record-journal path="output/${run_dir}/ALL_BOOKS_PAGES_${run_short_id.toUpperCase()}.JOURNAL.NDJSON" fsync="false"/>
        <record-xml-root-attr name="dataset">books_catalog_all_pages</record-xml-root-attr>
        <record-xml-record-attr name="id" from-field="book.record_key" required="true"/>
        <record-xml-record-attr name="url" from-field="book.url_libro" required="false"/>
        <record-set-group name="book" required="true">
            <record-set-field name="workflow_key" type="string" required="true"/>
            <record-set-field name="url_libro" type="string" required="true"/>
            <record-set-field name="record_key" type="string" required="true"/>
            <record-set-field name="titulo"     type="string" required="true"/>
            <record-set-field name="precio"     type="string" required="true"/>
        </record-set-group>
        <record-key>
            <key-field name="workflow_key"/>
            <key-field name="url_libro"/>
        </record-key>
    </record-create>

    <file-write path="output/${run_dir}/ALL_BOOKS_PAGES_${run_short_id.toUpperCase()}_SCRAPE.LOG.TXT" mkdir="true"> </file-write>

    <while condition="${hay_siguiente.toBoolean()}" max-loops="60">

        <box-def name="pagina">
            <evaluate>${pagina} + 1</evaluate>
        </box-def>

        <log>Scraping página ${pagina}: ${url_actual}</log>

        <box-def name="html">
            <httpx-call url="${url_actual}"/>
        </box-def>

        <box-def name="xml">
            <convert-html-to-xml>${html}</convert-html-to-xml>
        </box-def>

        <box-def name="libros">
            <xpath-extract expression="//article[@class='product_pod']">${xml}</xpath-extract>
        </box-def>

        <loop item="libro" index="i">
            <loop-list>
                <box name="libros"/>
            </loop-list>
            <loop-body>
                <box-def name="url_libro">
                    <xpath-extract expression=".//h3/a/@href">${libro}</xpath-extract>
                </box-def>
                <box-def name="titulo">
                    <xpath-extract expression=".//h3/a/@title">${libro}</xpath-extract>
                </box-def>
                <box-def name="precio">
                    <xpath-extract expression=".//p[@class='price_color']/text()">${libro}</xpath-extract>
                </box-def>
                <box-def name="contador">
                    <evaluate>${contador} + 1</evaluate>
                </box-def>
                <box-def name="record_key">
                    <compose>book-${contador}</compose>
                </box-def>
                <log>contador: ${contador}</log>
                <file-write path="output/${run_dir}/ALL_BOOKS_PAGES_${run_short_id.toUpperCase()}_SCRAPE.LOG.TXT" append="true" newline="true">${contador} - ${url_libro} - Title: ${titulo} - Price: ${precio}</file-write>
                <record-add to="booksRecords">
                    <record-add-group name="book">
                        <record-add-field name="workflow_key">${workflow_key}</record-add-field>
                        <record-add-field name="url_libro">${url_libro}</record-add-field>
                        <record-add-field name="record_key">${record_key}</record-add-field>
                        <record-add-field name="titulo">${titulo}</record-add-field>
                        <record-add-field name="precio">${precio}</record-add-field>
                    </record-add-group>
                </record-add>
            </loop-body>
        </loop>

        <box-def name="next_href">
            <xpath-extract expression="//li[@class='next']/a/@href">${xml}</xpath-extract>
        </box-def>

        <if condition="${next_href.isEmpty()}">
            <box-def name="hay_siguiente">false</box-def>
        </if>
        <else>
            <box-def name="url_actual">
                <compose>${base_url}${next_href}</compose>
            </box-def>
            <log>Siguiente URL: ${url_actual}</log>
        </else>

        <sleep ms="1000"/>
    </while>

    <log>Done — output/${run_dir}/ (NDJSON: LISTINGS_${run_short_id.toUpperCase()}.NDJSON)</log>

    <record-save from="booksRecords" format="json" path="output/${run_dir}/ALL_BOOKS_PAGES_${run_short_id.toUpperCase()}.JSON" include-metadata="true"/>
    <record-save from="booksRecords" format="csv" path="output/${run_dir}/ALL_BOOKS_PAGES_${run_short_id.toUpperCase()}.CSV" include-metadata="false"/>
    <record-save from="booksRecords" format="ndjson" path="output/${run_dir}/LISTINGS_${run_short_id.toUpperCase()}.NDJSON" include-metadata="false"/>
    <record-save from="booksRecords" format="xml" path="output/${run_dir}/ALL_BOOKS_PAGES_${run_short_id.toUpperCase()}.RECORDS.XML" include-metadata="true"/>
    <record-save from="booksRecords" format="html" path="output/${run_dir}/ALL_BOOKS_PAGES_${run_short_id.toUpperCase()}.HTML" html-title="Books to Scrape — all pages" include-metadata="true"/>
    <record-save from="booksRecords" format="txt" path="output/${run_dir}/ALL_BOOKS_PAGES_${run_short_id.toUpperCase()}.TXT" include-metadata="false"/>
    <record-save from="booksRecords" format="excel" path="output/${run_dir}/ALL_BOOKS_PAGES_${run_short_id.toUpperCase()}.XLSX" sheet-name="Libros" include-metadata="true"/>
    <record-save from="booksRecords" format="parquet" path="output/${run_dir}/ALL_BOOKS_PAGES_${run_short_id.toUpperCase()}.PARQUET" include-metadata="false"/>

    <record-save-metadata from="booksRecords" path="output/${run_dir}/BOOKSRECORDS_PRIVATE_METADATA_${run_short_id.toUpperCase()}.JSON"/>

    <file-write path="output/${run_dir}/RUN_MANIFEST.JSON">
        <compose>{"schema_version":"1","francis_workflow":"all_books_pages","description":"Index for this run. primary_ndjson is NDJSON: first line export header, then one JSON object per book row (titulo, precio, url_libro, record_key). Not a URL-only list.","ingestion_run_id":"${ingestion_run_id}","run_dir":"${run_dir}","run_utc":"${run_utc}","run_short_id":"${run_short_id}","source":"${source}","output_folder_relative":"output/${run_dir}","files":{"primary_ndjson":"LISTINGS_${run_short_id.toUpperCase()}.NDJSON","private_metadata_json":"BOOKSRECORDS_PRIVATE_METADATA_${run_short_id.toUpperCase()}.JSON","journal_ndjson":"ALL_BOOKS_PAGES_${run_short_id.toUpperCase()}.JOURNAL.NDJSON","exports_glob":"ALL_BOOKS_PAGES_${run_short_id.toUpperCase()}.*"}}</compose>
    </file-write>

</francis-workflow>
