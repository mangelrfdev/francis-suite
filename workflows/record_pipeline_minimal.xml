<?xml version="1.0" encoding="UTF-8"?>
<francis-workflow>

    <!--
        Aligned with examples/demos/all_books_pages.xml (metadata, journal, xml attrs, multi-format save).
        Listing fields follow integrations/web/01-ESPECIFICACION-SITIO-INGESTA-ADMIN.md (ingestion contract).
        UTF-8: comuna and titles can use Spanish characters (e.g. Ñuñoa).

        Ask the web repo for: SQL or types for properties table — see integrations/web/07-PARA-FRANCIS-ALINEAR-RECORD-SCHEMA.md

        Docker default workflow (image has workflows/ only, not examples/).
        Run (host): uv run francis-suite run workflows/record_pipeline_minimal.xml
        Upstream twin: examples/demos/record_pipeline_minimal.xml — keep in sync when changing this file.
        Outputs: output/record_pipeline_minimal/
    -->

    <box-def name="workflow_key">listings_pipeline_minimal</box-def>
    <box-def name="scraper_name">listings_pipeline_minimal</box-def>
    <box-def name="case_key">demo-property-pipeline</box-def>
    <box-def name="ingestion_run_id">local-run</box-def>
    <box-def name="source">demo_portal</box-def>
    <!-- Demo ISO timestamps for published_at / scraped_at (replace with compose/evaluate in real scrapes) -->
    <box-def name="demo_published_1">2026-03-15T12:00:00</box-def>
    <box-def name="demo_published_2">2026-03-20T10:30:00</box-def>
    <box-def name="demo_scraped">2026-04-01T18:00:00</box-def>

    <record-create name="listingsRecords">
        <record-metadata>
            <metadata-add-field name="scraper_name">${scraper_name}</metadata-add-field>
            <metadata-add-field name="case_key">${case_key}</metadata-add-field>
            <metadata-add-field name="ingestion_run_id">${ingestion_run_id}</metadata-add-field>
        </record-metadata>
        <record-export-attr name="example">record_pipeline_minimal</record-export-attr>
        <record-export-attr name="case_key">${case_key}</record-export-attr>
        <record-export-attr name="source">${source}</record-export-attr>
        <record-export-system name="session_id"/>
        <record-export-system name="exported_at"/>
        <record-export-system name="francis_suite_version"/>
        <record-journal path="output/record_pipeline_minimal/listings.journal.ndjson" fsync="false"/>
        <record-xml-root-attr name="dataset">listings_demo</record-xml-root-attr>
        <record-xml-record-attr name="id" from-field="listing.external_id" required="true"/>
        <record-xml-record-attr name="url" from-field="listing.source_url" required="false"/>
        <record-set-group name="listing" required="true">
            <record-set-field name="workflow_key" type="string" required="true"/>
            <record-set-field name="source" type="string" required="true"/>
            <record-set-field name="external_id" type="string" required="true"/>
            <record-set-field name="title" type="string" required="true"/>
            <record-set-field name="price" type="decimal" required="true"/>
            <record-set-field name="currency" type="string" required="true"/>
            <record-set-field name="property_type" type="string" required="true"/>
            <record-set-field name="operation_type" type="string" required="true"/>
            <record-set-field name="comuna" type="string" required="true"/>
            <record-set-field name="bedrooms" type="integer" required="false" null-if-empty="true"/>
            <record-set-field name="bathrooms" type="integer" required="false" null-if-empty="true"/>
            <record-set-field name="surface" type="decimal" required="false" null-if-empty="true"/>
            <record-set-field name="image_url" type="url" required="false" null-if-empty="true"/>
            <record-set-field name="source_url" type="url" required="true"/>
            <record-set-field name="publisher_name" type="string" required="false" null-if-empty="true"/>
            <record-set-field name="published_at" type="datetime" required="false" null-if-empty="true"/>
            <record-set-field name="scraped_at" type="datetime" required="false" null-if-empty="true"/>
        </record-set-group>
        <record-key>
            <key-field name="workflow_key"/>
            <key-field name="source"/>
            <key-field name="external_id"/>
        </record-key>
    </record-create>

    <file-write path="output/record_pipeline_minimal/listings_log.txt" mkdir="true"> </file-write>

    <!-- Row 1: Las Condes -->
    <record-add to="listingsRecords">
        <record-add-group name="listing">
            <record-add-field name="workflow_key">${workflow_key}</record-add-field>
            <record-add-field name="source">${source}</record-add-field>
            <record-add-field name="external_id">prop-001</record-add-field>
            <record-add-field name="title">Depto ejemplo Las Condes</record-add-field>
            <record-add-field name="price">450000</record-add-field>
            <record-add-field name="currency">CLP</record-add-field>
            <record-add-field name="property_type">departamento</record-add-field>
            <record-add-field name="operation_type">arriendo</record-add-field>
            <record-add-field name="comuna">Las Condes</record-add-field>
            <record-add-field name="bedrooms">2</record-add-field>
            <record-add-field name="bathrooms">2</record-add-field>
            <record-add-field name="surface">85</record-add-field>
            <record-add-field name="image_url">https://example.com/img/prop-001.jpg</record-add-field>
            <record-add-field name="source_url">https://example.com/listings/prop-001</record-add-field>
            <record-add-field name="publisher_name">BValue Propiedades</record-add-field>
            <record-add-field name="published_at">${demo_published_1}</record-add-field>
            <record-add-field name="scraped_at">${demo_scraped}</record-add-field>
        </record-add-group>
    </record-add>
    <file-write path="output/record_pipeline_minimal/listings_log.txt" append="true" newline="true">accepted prop-001</file-write>

    <!-- Row 2: duplicate key (same workflow_key + source + external_id as row 1) -->
    <record-add to="listingsRecords">
        <record-add-group name="listing">
            <record-add-field name="workflow_key">${workflow_key}</record-add-field>
            <record-add-field name="source">${source}</record-add-field>
            <record-add-field name="external_id">prop-001</record-add-field>
            <record-add-field name="title">Depto ejemplo titulo actualizado</record-add-field>
            <record-add-field name="price">440000</record-add-field>
            <record-add-field name="currency">CLP</record-add-field>
            <record-add-field name="property_type">departamento</record-add-field>
            <record-add-field name="operation_type">arriendo</record-add-field>
            <record-add-field name="comuna">Las Condes</record-add-field>
            <record-add-field name="bedrooms">2</record-add-field>
            <record-add-field name="bathrooms">2</record-add-field>
            <record-add-field name="surface">85</record-add-field>
            <record-add-field name="image_url">https://example.com/img/prop-001.jpg</record-add-field>
            <record-add-field name="source_url">https://example.com/listings/prop-001</record-add-field>
            <record-add-field name="publisher_name">BValue Propiedades</record-add-field>
            <record-add-field name="published_at">${demo_published_1}</record-add-field>
            <record-add-field name="scraped_at">${demo_scraped}</record-add-field>
        </record-add-group>
    </record-add>

    <!-- Row 3: Ñuñoa (UTF-8) — same contract as ingestion spec -->
    <record-add to="listingsRecords">
        <record-add-group name="listing">
            <record-add-field name="workflow_key">${workflow_key}</record-add-field>
            <record-add-field name="source">${source}</record-add-field>
            <record-add-field name="external_id">prop-002</record-add-field>
            <record-add-field name="title">Casa ejemplo Ñuñoa</record-add-field>
            <record-add-field name="price">12000.5</record-add-field>
            <record-add-field name="currency">UF</record-add-field>
            <record-add-field name="property_type">casa</record-add-field>
            <record-add-field name="operation_type">venta</record-add-field>
            <record-add-field name="comuna">Ñuñoa</record-add-field>
            <record-add-field name="bedrooms">3</record-add-field>
            <record-add-field name="bathrooms">2</record-add-field>
            <record-add-field name="surface">120</record-add-field>
            <record-add-field name="image_url">https://example.com/img/prop-002.jpg</record-add-field>
            <record-add-field name="source_url">https://example.com/listings/prop-002</record-add-field>
            <record-add-field name="publisher_name">Corredora Ejemplo SpA</record-add-field>
            <record-add-field name="published_at">${demo_published_2}</record-add-field>
            <record-add-field name="scraped_at">${demo_scraped}</record-add-field>
        </record-add-group>
    </record-add>

    <log>Listo: journal en listings.journal.ndjson; exports finales en listings.* segun cada record-save</log>

    <record-save from="listingsRecords" format="json" path="output/record_pipeline_minimal/listings.json" include-metadata="true"/>
    <record-save from="listingsRecords" format="csv" path="output/record_pipeline_minimal/listings.csv" include-metadata="false"/>
    <record-save from="listingsRecords" format="ndjson" path="output/record_pipeline_minimal/listings.ndjson" include-metadata="false"/>
    <record-save from="listingsRecords" format="xml" path="output/record_pipeline_minimal/listings.records.xml" include-metadata="true"/>
    <record-save from="listingsRecords" format="html" path="output/record_pipeline_minimal/listings.html" html-title="Listings demo - record pipeline minimal" include-metadata="true"/>
    <record-save from="listingsRecords" format="txt" path="output/record_pipeline_minimal/listings.txt" include-metadata="false"/>
    <record-save from="listingsRecords" format="excel" path="output/record_pipeline_minimal/listings.xlsx" sheet-name="Listings" include-metadata="true"/>
    <record-save from="listingsRecords" format="parquet" path="output/record_pipeline_minimal/listings.parquet" include-metadata="false"/>

    <record-save-duplicates from="listingsRecords" format="ndjson" path="output/record_pipeline_minimal/listings_duplicates.ndjson"/>

    <record-save-metadata from="listingsRecords" path="output/record_pipeline_minimal/listings_private_metadata.json"/>
</francis-workflow>
