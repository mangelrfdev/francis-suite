# Copy to `.env` (gitignored) and set your own path. Never commit `.env`.
# Docker Desktop on Windows: use forward slashes, e.g. C:/Users/YOU/Documents/workflows

WORKFLOWS_HOST_PATH=C:/path/to/your/workflows

# Optional — only for docker-compose.ocir.yml (image from OCIR / registry, no local build):
# FRANCIS_IMAGE=sa-santiago-1.ocir.io/YOUR_NAMESPACE/francis-suite:1.0.0
#
# Linux VM: match host user so ./docker-output is not root-owned (default 1000 = typical first ubuntu user):
# DOCKER_UID=1000
# DOCKER_GID=1000
