<?xml version="1.0" encoding="UTF-8"?>
<!--
  Francis Suite — Enriched XSD for XML tooling.

  Purpose:
    Provides IntelliSense, validation and autocompletion for Francis Suite
    workflow XML files in editors that support XSD (VS Code with Red Hat XML,
    IntelliJ, Eclipse, etc).

  Scope:
    - Root element: <francis-workflow>
    - Strict attribute definitions for the most-used hands.
    - All other registered hands fall back to HandLaxType (any attrs, any children).

  Notes:
    - The base generator (`francis-suite schema`) produces a minimal XSD.
      This file is the *enriched* version, maintained manually.
    - When adding a new hand: add its element in the root <xs:choice>,
      and optionally a dedicated complexType with attribute definitions.
    - See docs/xml-tooling.md for maintenance instructions.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!-- ======================================================== -->
  <!-- Generic lax type: mixed content, any children, any attrs -->
  <!-- Used as fallback for hands without specific attributes   -->
  <!-- ======================================================== -->
  <xs:complexType name="HandLaxType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- Mixed content with optional structured children (no extra attrs) -->
  <xs:complexType name="HandLaxNoAttrsType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================================================== -->
  <!-- ROOT: <francis-workflow>                                 -->
  <!-- ======================================================== -->
  <xs:element name="francis-workflow">
    <xs:complexType>
      <xs:sequence>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <!-- Core: variables and data -->
          <xs:element name="box"                           type="BoxType"/>
          <xs:element name="box-def"                       type="BoxDefType"/>
          <xs:element name="shared-box"                    type="SharedBoxType"/>
          <xs:element name="shared-box-def"                type="SharedBoxDefType"/>
          <xs:element name="compose"                       type="HandLaxNoAttrsType"/>
          <xs:element name="build-list"                    type="HandLaxType"/>
          <xs:element name="evaluate"                      type="HandLaxNoAttrsType"/>

          <!-- Control flow -->
          <xs:element name="if"                            type="IfType"/>
          <xs:element name="else"                          type="HandLaxNoAttrsType"/>
          <xs:element name="case"                          type="CaseType"/>
          <xs:element name="loop"                          type="HandLaxNoAttrsType"/>
          <xs:element name="loop-list"                     type="HandLaxNoAttrsType"/>
          <xs:element name="loop-body"                     type="HandLaxNoAttrsType"/>
          <xs:element name="while"                         type="WhileType"/>
          <xs:element name="try"                           type="HandLaxNoAttrsType"/>
          <xs:element name="catch"                         type="HandLaxNoAttrsType"/>
          <xs:element name="exit"                          type="ExitType"/>

          <!-- Functions -->
          <xs:element name="function-create"               type="FunctionCreateType"/>
          <xs:element name="function-call"                 type="FunctionCallType"/>
          <xs:element name="function-param"                type="FunctionParamType"/>
          <xs:element name="function-return"               type="HandLaxNoAttrsType"/>
          <xs:element name="call-workflow"                 type="CallWorkflowType"/>

          <!-- Logging, timing, liveness -->
          <xs:element name="log"                           type="LogType"/>
          <xs:element name="sleep"                         type="SleepType"/>
          <xs:element name="sleep-min"                     type="HandLaxNoAttrsType"/>
          <xs:element name="sleep-max"                     type="HandLaxNoAttrsType"/>
          <xs:element name="sleep-avg"                     type="HandLaxNoAttrsType"/>
          <xs:element name="pause-task"                    type="PauseTaskType"/>
          <xs:element name="session-pulse"                 type="HandLaxType"/>

          <!-- HTTP / httpx -->
          <xs:element name="httpx-call"                    type="HttpxCallType"/>
          <xs:element name="httpx-close"                   type="HandLaxType"/>
          <xs:element name="httpx-last-status"             type="HandLaxType"/>
          <xs:element name="httpx-get-headers"             type="HandLaxType"/>
          <xs:element name="httpx-get-cookies"             type="HandLaxType"/>
          <xs:element name="set-proxy"                     type="SetProxyType"/>

          <!-- Parsing / extraction -->
          <xs:element name="xpath-extract"                 type="XPathExtractType"/>
          <xs:element name="regex"                         type="RegexType"/>
          <xs:element name="regex-input"                   type="HandLaxNoAttrsType"/>
          <xs:element name="regex-pattern"                 type="HandLaxNoAttrsType"/>
          <xs:element name="regex-result"                  type="HandLaxNoAttrsType"/>
          <xs:element name="text-split"                    type="TextSplitType"/>

          <!-- Conversions -->
          <xs:element name="convert-base64-to-binary"      type="HandLaxType"/>
          <xs:element name="convert-base64-to-text"        type="HandLaxType"/>
          <xs:element name="convert-binary-to-base64"      type="HandLaxType"/>
          <xs:element name="convert-csv-to-json"           type="HandLaxType"/>
          <xs:element name="convert-html-entities-to-text" type="HandLaxType"/>
          <xs:element name="convert-html-to-xml"           type="HandLaxType"/>
          <xs:element name="convert-json-to-csv"           type="HandLaxType"/>
          <xs:element name="convert-json-to-xml"           type="HandLaxType"/>
          <xs:element name="convert-text-to-base64"        type="HandLaxType"/>
          <xs:element name="convert-text-to-url"           type="HandLaxType"/>
          <xs:element name="convert-url-to-text"           type="HandLaxType"/>
          <xs:element name="convert-xml-to-csv"            type="HandLaxType"/>
          <xs:element name="convert-xml-to-json"           type="HandLaxType"/>

          <!-- Files -->
          <xs:element name="file-read"                     type="FileReadType"/>
          <xs:element name="file-write"                    type="FileWriteType"/>
          <xs:element name="file-manage"                   type="FileManageType"/>
          <xs:element name="file-download"                 type="FileDownloadType"/>
          <xs:element name="file-upload"                   type="FileUploadType"/>

          <!-- Records -->
          <xs:element name="record-create"                 type="RecordCreateType"/>
          <xs:element name="record-add"                    type="RecordAddType"/>
          <xs:element name="record-count"                  type="RecordCountType"/>
          <xs:element name="record-last-added"             type="RecordLastAddedType"/>
          <xs:element name="record-save"                   type="RecordSaveType"/>
          <xs:element name="record-save-duplicates"        type="RecordSaveType"/>
          <xs:element name="record-save-validation-errors" type="RecordSaveType"/>
          <xs:element name="record-save-metadata"          type="RecordSaveMetadataType"/>
          <xs:element name="record-private-metadata"       type="RecordPrivateMetadataType"/>
        </xs:choice>
      </xs:sequence>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <!-- ======================================================== -->
  <!-- Shared simple types                                      -->
  <!-- ======================================================== -->
  <xs:simpleType name="LogLevelType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="info"/>
      <xs:enumeration value="debug"/>
      <xs:enumeration value="warning"/>
      <xs:enumeration value="error"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RecordFormatType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="json"/>
      <xs:enumeration value="csv"/>
      <xs:enumeration value="ndjson"/>
      <xs:enumeration value="xml"/>
      <xs:enumeration value="html"/>
      <xs:enumeration value="txt"/>
      <xs:enumeration value="xlsx"/>
      <xs:enumeration value="parquet"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HttpMethodType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="GET"/>
      <xs:enumeration value="POST"/>
      <xs:enumeration value="PUT"/>
      <xs:enumeration value="PATCH"/>
      <xs:enumeration value="DELETE"/>
      <xs:enumeration value="HEAD"/>
      <xs:enumeration value="OPTIONS"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="BoolStringType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ======================================================== -->
  <!-- Specific hand types (strict attributes)                  -->
  <!-- ======================================================== -->

  <xs:complexType name="BoxType" mixed="true">
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="BoxDefType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="SharedBoxType" mixed="true">
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="SharedBoxDefType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="LogType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="level" type="LogLevelType" default="info"/>
  </xs:complexType>

  <xs:complexType name="SleepType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="ms" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="PauseTaskType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="message" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="IfType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="condition" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="CaseType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="value" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="WhileType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="condition" type="xs:string"/>
    <xs:attribute name="max-iterations" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="ExitType" mixed="true">
    <xs:attribute name="code" type="xs:string"/>
    <xs:attribute name="message" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="FunctionCreateType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="FunctionCallType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="FunctionParamType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="CallWorkflowType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="path" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="HttpxCallType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="url" type="xs:string"/>
    <xs:attribute name="method" type="HttpMethodType" default="GET"/>
    <xs:attribute name="timeout" type="xs:string"/>
    <xs:attribute name="stream" type="BoolStringType"/>
    <xs:attribute name="follow-redirects" type="BoolStringType"/>
    <xs:attribute name="verify" type="BoolStringType"/>
  </xs:complexType>

  <xs:complexType name="SetProxyType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="proxy" type="xs:string"/>
    <xs:attribute name="probe-url" type="xs:string"/>
    <xs:attribute name="ok-xpath" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="XPathExtractType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="expression" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="RegexType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="pattern" type="xs:string"/>
    <xs:attribute name="flags" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="TextSplitType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="delimiter" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="FileReadType" mixed="true">
    <xs:attribute name="path" type="xs:string" use="required"/>
    <xs:attribute name="encoding" type="xs:string"/>
    <xs:attribute name="mode" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="FileWriteType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="path" type="xs:string" use="required"/>
    <xs:attribute name="append" type="BoolStringType"/>
    <xs:attribute name="mkdir" type="BoolStringType"/>
    <xs:attribute name="encoding" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="FileManageType" mixed="true">
    <xs:attribute name="action" type="xs:string"/>
    <xs:attribute name="path" type="xs:string"/>
    <xs:attribute name="to" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="FileDownloadType" mixed="true">
    <xs:attribute name="url" type="xs:string" use="required"/>
    <xs:attribute name="to" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="FileUploadType" mixed="true">
    <xs:attribute name="path" type="xs:string" use="required"/>
    <xs:attribute name="url" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="RecordCreateType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="RecordAddType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="record" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="RecordCountType" mixed="true">
    <xs:attribute name="record" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="RecordLastAddedType" mixed="true">
    <xs:attribute name="record" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="RecordSaveType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="record" type="xs:string" use="required"/>
    <xs:attribute name="format" type="RecordFormatType" use="required"/>
    <xs:attribute name="path" type="xs:string"/>
    <xs:attribute name="pretty" type="BoolStringType"/>
    <xs:attribute name="append" type="BoolStringType"/>
  </xs:complexType>

  <xs:complexType name="RecordSaveMetadataType" mixed="true">
    <xs:attribute name="record" type="xs:string" use="required"/>
    <xs:attribute name="path" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="RecordPrivateMetadataType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="record" type="xs:string" use="required"/>
  </xs:complexType>

</xs:schema>
