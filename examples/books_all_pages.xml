<?xml version="1.0" encoding="UTF-8"?>
<francis-workflow>

    <!-- URL base -->
    <box-def name="base_url">http://books.toscrape.com/catalogue/</box-def>
    <box-def name="url_actual">http://books.toscrape.com/catalogue/page-1.html</box-def>
    <box-def name="hay_siguiente">true</box-def>
    <box-def name="pagina">0</box-def>
    <box-def name="contador">0</box-def>

    <!--
        Record: una fila por libro.
        record-export-* → metadatos en todos los formatos que lo soporten (_export en JSON, etc.).
        record-xml-* → solo el archivo XML: attrs en <Records> / <record> independientes de <book>...</book>.
        Ver docs/guides/record-save.md
    -->
    <record-create name="booksRecords">
        <record-export-attr name="example">books_all_pages</record-export-attr>
        <record-export-attr name="source">books.toscrape.com</record-export-attr>
        <record-export-system name="session_id"/>
        <record-export-system name="exported_at"/>
        <record-export-system name="francis_suite_version"/>
        <!-- record-journal = NDJSON vivo (header + filas + cierre process); record-save = export final por formato -->
        <record-journal path="output/books_all_pages.journal.ndjson" fsync="false"/>
        <record-xml-root-attr name="dataset">books_catalog</record-xml-root-attr>
        <record-xml-record-attr name="id" from-field="book.record_key" required="true"/>
        <record-set-group name="book" required="true">
            <record-set-field name="record_key" type="string" required="true"/>
            <record-set-field name="titulo"           type="string" required="true"/>
            <record-set-field name="precio"           type="string" required="true"/>
        </record-set-group>
    </record-create>

    <!-- Crear archivo de salida -->
    <file-write path="output/todos_los_libros.txt" mkdir="true"> </file-write>

    <while condition="${hay_siguiente.toBoolean()}" max-loops="60">

        <!-- Contador de página -->
        <box-def name="pagina">
            <evaluate>${pagina} + 1</evaluate>
        </box-def>

        <log>Scraping página ${pagina}: ${url_actual}</log>

        <!-- 1. Fetch página -->
        <box-def name="html">
            <httpx-call url="${url_actual}"/>
        </box-def>

        <!-- 2. Convertir a XML -->
        <box-def name="xml">
            <convert-html-to-xml>${html}</convert-html-to-xml>
        </box-def>

        <!-- 3. Extraer libros -->
        <box-def name="libros">
            <xpath-extract expression="//article[@class='product_pod']">${xml}</xpath-extract>
        </box-def>

        <!-- 4. Iterar libros de esta página -->
        <loop item="libro" index="i">
            <loop-list>
                <box name="libros"/>
            </loop-list>
            <loop-body>
                <box-def name="titulo">
                    <xpath-extract expression=".//h3/a/@title">${libro}</xpath-extract>
                </box-def>
                <box-def name="precio">
                    <xpath-extract expression=".//p[@class='price_color']/text()">${libro}</xpath-extract>
                </box-def>
                <box-def name="contador">
                    <evaluate>${contador} + 1</evaluate>
                </box-def>
                <box-def name="record_key">
                    <compose>book-${contador}</compose>
                </box-def>
                <log>contador: ${contador}</log>
                <file-write path="output/todos_los_libros.txt" append="true" newline="true">${contador} - Title: ${titulo} - Price: ${precio}</file-write>
                <record-add to="booksRecords">
                    <record-add-group name="book">
                        <record-add-field name="record_key">${record_key}</record-add-field>
                        <record-add-field name="titulo">${titulo}</record-add-field>
                        <record-add-field name="precio">${precio}</record-add-field>
                    </record-add-group>
                </record-add>
            </loop-body>
        </loop>

        <!-- 5. Buscar botón next -->
        <box-def name="next_href">
            <xpath-extract expression="//li[@class='next']/a/@href">${xml}</xpath-extract>
        </box-def>

        <!-- 6. Si hay next → actualizar URL, si no → parar -->
        <if condition="${next_href.isEmpty()}">
            <box-def name="hay_siguiente">false</box-def>
        </if>
        <else>
            <box-def name="url_actual">
                <compose>${base_url}${next_href}</compose>
            </box-def>
            <log>Siguiente URL: ${url_actual}</log>
        </else>

        <sleep ms="1000"/>
    </while>

    <log>Scraping completado — ver output/todos_los_libros.txt y los exports en output/books.*</log>

    <!-- Ocho saves: solo format + path; los extras vienen del <record-create> (docs/guides/record-save.md) -->
    <record-save from="booksRecords" format="json" path="output/books.json"/>
    <record-save from="booksRecords" format="csv" path="output/books.csv"/>
    <record-save from="booksRecords" format="ndjson" path="output/books.ndjson"/>
    <record-save from="booksRecords" format="xml" path="output/books.xml"/>
    <record-save from="booksRecords" format="html" path="output/books.html" html-title="Books to Scrape"/>
    <record-save from="booksRecords" format="txt" path="output/books.txt"/>
    <record-save from="booksRecords" format="excel" path="output/books.xlsx" sheet-name="Libros"/>
    <record-save from="booksRecords" format="parquet" path="output/books.parquet"/>

</francis-workflow>